+  print("Checking StandStill polarity (regression guard):")
+  check_standstill_polarity(can_msgs)
+  print("\nALL OFFLINE CHECKS PASSED (plumbing only; actuation is on-car).")
+
+
+if __name__ == "__main__":
+  main()
